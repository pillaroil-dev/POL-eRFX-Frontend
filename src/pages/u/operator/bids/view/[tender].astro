---
import { BidPlacementDataTable } from "@/components/ui/react/bid-placments-data-table";
import OperatorLayout from "@/layouts/OperatorLayout.astro";
import Text from "@/components/Text.astro";
import { Headers } from "@/constants";

const { tender } = Astro.params;

const res = await fetch(
  `${import.meta.env.API_ENDPOINT}/v1/bids/bid-placement/?${new URLSearchParams({ tender }).toString()}`,
  { headers: Headers }
);
const bids = await res.json();
const role = Astro.locals?.user?.user?.role;

const title = bids?.data[0]?.tender?.title;


---

<OperatorLayout title={`Bids | ${title}`}>
    <div
    class="flex flex-col bg-slate-100 dark:bg-natural gap-x-4 ml-24 w-[calc(100%-7rem)] p-8 mt-24 mb-8 h-full rounded-2xl"
  >
    <div class="flex flex-col justify-between space-y-4">
      <Text type="p" content={`${title}`} className="!font-bold !text-lg" />
      <Text type="p" content={`Bid(s)`} className="!font-bold text-xl" />
    </div>
    <div class="my-12">
      <BidPlacementDataTable client:only="react" data={bids?.data} role={role} />
    </div>
  </div>
</OperatorLayout>
