---
import Text from "../../../../components/Text.astro";
import { BidGroupingDataTable } from "@/components/ui/react/bid-grouping-data-table";
import OperatorLayout from "@/layouts/OperatorLayout.astro";
import { Headers } from "@/constants";

const res = await fetch(`${process.env.API_ENDPOINT}/v1/bids/bid-placement`, {
  headers: Headers,
});
const bids = await res.json();

const groupedData = Object.values(bids?.data.reduce((obj, item) => {
        const key = item.tenderId;
        if (!obj[key]) {
            obj[key] = {
                id: item.tenderId,
                tender: {title: item.tender.title, status: item.tender.status},
                bids: [],
            };
        }
        obj[key].bids.push(item);
        return obj;
    }, {}));

const role = Astro.locals?.user?.user?.role;
const operatorEmail = Astro.locals?.user?.email;
---

<OperatorLayout title="Bids">
  <div
    class="flex flex-col bg-slate-100 dark:bg-natural gap-x-4 ml-24 w-[calc(100%-7rem)] p-8 mt-24 mb-8 h-full rounded-2xl"
  >
    <div class="flex justify-between">
      <Text type="p" content="Bids" className="!font-bold text-xl" />
    </div>
    <div class="my-12">
      <BidGroupingDataTable 
        client:only="react" 
        data={groupedData} 
        operatorEmail={operatorEmail}
        role={role}
      />
    </div>
  </div>
</OperatorLayout>
