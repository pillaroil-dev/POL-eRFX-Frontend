---
import UserLayout from "../../../../layouts/UserLayout.astro";
import Text from '../../../../components/Text.astro'
import MemberComponent from "@/components/ui/react/member-component";
import {AddNewMemberFormSheet} from "@/components/ui/react/add-new-member-form-sheet";

import {actions} from "astro:actions";

const contractorId = Astro.locals?.user?.id;

//@ts-ignore
const {data, error} = await Astro.callAction(actions.createMemberAction.fetch);
const {members} = data;
const membersData = members.filter(member => member.contractorId === contractorId);
---

<UserLayout title="Members">
  <div
    class="flex flex-col bg-slate-100 dark:bg-natural gap-x-4 ml-24 w-[calc(100%-7rem)] p-8 mt-24 mb-8 h-full rounded-2xl"
  >
    <div class="flex justify-between">
      <Text type="p" content="Members" className="!font-bold text-xl" />
      <AddNewMemberFormSheet client:only="react" contractorId={contractorId} />
    </div>
    <div class="my-12">
        <div class=" grid grid-cols-3 gap-4 w-full mt-8">
            {membersData?.length > 0 && membersData.map((member) => (
                <MemberComponent member={member} client:only="react" /> 
            ))}
        </div>
        {membersData?.length === 0 && (
            <div class="flex mx-auto items-center justify-center w-full h-full">
                <span class="text-2xl font-bold text-muted-foreground">No members found</span>
            </div>
        )}
        </div>
      </div>
    </div>
  </div>
</UserLayout>
