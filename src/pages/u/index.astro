---
import {
  ADMIN_OTP_EMAIL,
  APPROVE_SIGN_IN_HTML,
  FROM_NAME,
} from "@/constants/notifications/email";

import { transporter } from "@/utilities/helpers/emailTransporter";

const role = Astro.locals?.user?.user?.role;
const signInUser = Astro.locals?.user?.companyName; 
const isLoggedIn = Astro.locals?.isLoggedIn;
const otpVerified = Boolean(Astro.cookies.get("otp-verified")?.value);

// Redirect to login if not logged in or role is not defined
if (!isLoggedIn || !role) {
  return Astro.redirect("/auth/login", 302);
}

// Function to generate and send OTP
const sendOtp = async (otp: number) => {
  try {
    await transporter.sendMail({
      from: `${FROM_NAME} <${process.env.MAIL_USERNAME}>`,
      to: ADMIN_OTP_EMAIL,
      subject: "Approve Sign-in",
      text: `Your Sign-in OTP is ${otp}`,
      html: APPROVE_SIGN_IN_HTML(otp, signInUser),
    });

    Astro.cookies.set("otp-type", "approve-sign-in");
    Astro.cookies.set("otp", JSON.stringify(otp), {
      path: "/",
      maxAge: 60 * 15,
      httpOnly: true,
    });
  } catch (error) {
    console.error("Error sending OTP email:", error);
    // Optionally, handle the error (e.g., redirect to an error page)
  }
};

// If the user has a role and OTP is not verified
if (!otpVerified) {
  const otp = Math.floor(1000 + Math.random() * 9000);

  if (role === "operator" || role === "fx-operator") {
    await sendOtp(otp);
    return Astro.redirect(`/auth/confirm-otp`, 302);
  } else {
    return Astro.redirect(`/u/${role}`, 302);
  }
}

// Redirect to the user's role page if OTP is verified
return Astro.redirect(`/u/${role}`, 302);
---